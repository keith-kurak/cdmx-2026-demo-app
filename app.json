{
  "expo": {
    "name": "cdmx-2026-demo-app",
    "slug": "cdmx-2026-demo-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cdmx2026demoapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.keithco.cdmx2026demoapp"
    },
    "android": {
      "package": "com.keithco.cdmx2026demoapp",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "@react-native-vector-icons/ionicons",
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "HealthSnapshot",
              "displayName": "Today's Health",
              "description": "Your key trackers for today at a glance",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge"
                ],
                "initialLayout": "src/widgets/health-snapshot.ios.tsx"
              },
              "android": {
                "targetCellWidth": 3,
                "targetCellHeight": 3,
                "initialLayout": "src/widgets/health-snapshot.android.tsx"
              }
            }
          ]
        }
      ],
      "expo-font",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "e194340f-f7cc-429e-a7b7-b659212d8024"
      }
    },
    "owner": "keithco"
  }
}
